# EmployeeSphere Environment Configuration
# Copy this file to .env and adjust variables to match your environment.

PROJECT_NAME="EmployeeSphere – Workforce Management OS"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/employeesphere_db

# Security & Authentication
# Generate a strong 32+ character random secret key for production
SECRET_KEY=replace_with_a_random_secret_key_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

